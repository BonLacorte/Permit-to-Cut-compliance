generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
}

enum FeatureKey {
  PTC_FEES_CHECKER
  PTC_VALIDITY_CHECKER
  PTT_FEES_CHECKER
  PTT_VALIDITY_CHECKER
  PTT_VEHICLE_CAPACITY_CHECKER
}

enum ApplicationCheckType {
  Fee
  Validity
}

enum PttCheckType {
  Fee
  Validity
  Vehicle
}

enum PttValidityBasis {
  WithinMunicipality
  WithinProvince
  WithinRegion
  OutsideRegionInterIsland
}

enum PttVehicleCapacityCategory {
  SmallerThanJeep
  Jeep
  ElfOrSixWheelerTruck
  ForwardTruck
  TenWheelerTruck
  TwelveWheelerAndAbove
}

enum LocExemption {
  Owner
  Others
}

enum DocumentRequirementMode {
  Required
  Optional
  LocConditional
}

model User {
  id               String                 @id @default(cuid())
  name             String
  email            String                 @unique
  passwordHash     String
  role             Role                   @default(STAFF)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  records          ApplicationRecord[]    @relation("CreatedRecords")
  editedRecords    ApplicationRecord[]    @relation("EditedRecords")
  pttRecords       PttApplicationRecord[] @relation("CreatedPttRecords")
  editedPttRecords PttApplicationRecord[] @relation("EditedPttRecords")
  progress         ProgressEntry[]
  activity         ActivityLog[]
  featureAccess    UserFeatureAccess[]
  checkRuns        ApplicationCheckRun[]
  pttCheckRuns     PttApplicationCheckRun[]

  @@map("users")
}

model UserFeatureAccess {
  id        String     @id @default(cuid())
  userId    String
  feature   FeatureKey
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@map("user_feature_access")
}

model PtcVersion {
  id                String                 @id @default(cuid())
  group             String                 @default("PTC")
  name              String
  description       String?
  active            Boolean                @default(true)
  sortOrder         Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  applicationTypes  ApplicationType[]
  records           ApplicationRecord[]
  pttRecords        PttApplicationRecord[]
  pttTransportTypes PttTransportType[]
  calculationRules  PtcCalculationRule[]

  @@unique([group, name])
  @@map("ptc_versions")
}

model ApplicationType {
  id        String              @id @default(cuid())
  group     String              @default("PTC")
  versionId String
  name      String
  active    Boolean             @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  version   PtcVersion          @relation(fields: [versionId], references: [id])
  documents RequiredDocument[]
  records   ApplicationRecord[]
  calculationRules PtcCalculationRule[]

  @@unique([versionId, name])
  @@index([group])
  @@map("application_types")
}

model RequiredDocument {
  id                String                  @id @default(cuid())
  applicationTypeId String
  name              String
  active            Boolean                 @default(true)
  requirementMode   DocumentRequirementMode @default(Required)
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  applicationType   ApplicationType         @relation(fields: [applicationTypeId], references: [id], onDelete: Cascade)
  progressDocuments ProgressDocument[]

  @@unique([applicationTypeId, name])
  @@map("required_documents")
}

model RegionalOffice {
  id                String             @id @default(cuid())
  group             String             @default("PTC")
  name              String
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  provincialOffices ProvincialOffice[]

  @@unique([group, name])
  @@map("regional_offices")
}

model ProvincialOffice {
  id               String         @id @default(cuid())
  regionalOfficeId String
  name             String
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  regionalOffice   RegionalOffice @relation(fields: [regionalOfficeId], references: [id])

  @@unique([regionalOfficeId, name])
  @@map("provincial_offices")
}

model ApplicationRecord {
  id                   String             @id @default(cuid())
  group                String             @default("PTC")
  versionId            String?
  applicantName        String?
  applicationTypeId    String?
  remarks              String?
  ptcNumber            String?
  dateIssued           DateTime?
  regionalOffice       String?
  provincialOffice     String?
  municipality         String?
  barangay             String?
  treesApplied         Int?
  treesApproved        Int?
  seedlingsReplacement Int?
  recordedValidityDays Int?
  actualValidityDays   Int?
  actualFee            Decimal?           @db.Decimal(12, 2)
  recordedFee          Decimal?           @db.Decimal(12, 2)
  officialReceiptNumber String?
  replantedSeedlings   Boolean?
  locExemption         LocExemption?
  agriculturist        String?
  recommendingApproval String?
  approved             String?
  createdById          String
  editedById           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  version              PtcVersion?        @relation(fields: [versionId], references: [id])
  applicationType      ApplicationType?   @relation(fields: [applicationTypeId], references: [id])
  createdBy            User               @relation("CreatedRecords", fields: [createdById], references: [id])
  editedBy             User?              @relation("EditedRecords", fields: [editedById], references: [id])
  progressEntries      ProgressEntry[]
  progressDocuments    ProgressDocument[]
  checkRuns            ApplicationCheckRun[]
  checkFindings        ApplicationCheckFinding[]

  @@index([applicationTypeId])
  @@index([versionId])
  @@index([group])
  @@index([ptcNumber])
  @@index([editedById])
  @@map("application_records")
}

model PtcCalculationRule {
  id                         String           @id @default(cuid())
  versionId                  String
  applicationTypeId          String?
  processingTiers            Json
  additionalProcessingStep   Int              @default(50)
  additionalProcessingFee    Decimal          @default(200) @db.Decimal(12, 2)
  applicationFeePerTree      Decimal          @default(100) @db.Decimal(12, 2)
  replantingFeePerTree       Decimal          @default(100) @db.Decimal(12, 2)
  maxTreesPerPtc             Int              @default(100)
  validityBrackets           Json
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  version                    PtcVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  applicationType            ApplicationType? @relation(fields: [applicationTypeId], references: [id], onDelete: Cascade)

  @@unique([versionId, applicationTypeId])
  @@index([versionId])
  @@index([applicationTypeId])
  @@map("ptc_calculation_rules")
}

model ApplicationCheckRun {
  id                  String               @id @default(cuid())
  applicationRecordId String
  checkType           ApplicationCheckType
  appliedById         String
  inputSnapshot       Json
  ruleSnapshot        Json
  outputSnapshot      Json
  comparisonSnapshot  Json
  createdAt           DateTime             @default(now())
  applicationRecord   ApplicationRecord    @relation(fields: [applicationRecordId], references: [id], onDelete: Cascade)
  appliedBy           User                 @relation(fields: [appliedById], references: [id])

  @@index([applicationRecordId, createdAt])
  @@index([appliedById])
  @@map("application_check_runs")
}

model ApplicationCheckFinding {
  id                  String               @id @default(cuid())
  applicationRecordId String
  checkType           ApplicationCheckType
  message             String
  active              Boolean              @default(true)
  comparisonSnapshot  Json
  resolvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  applicationRecord   ApplicationRecord    @relation(fields: [applicationRecordId], references: [id], onDelete: Cascade)

  @@unique([applicationRecordId, checkType])
  @@index([applicationRecordId, active])
  @@map("application_check_findings")
}

model ProgressEntry {
  id                  String             @id @default(cuid())
  applicationRecordId String
  userId              String
  remarks             String?
  createdAt           DateTime           @default(now())
  applicationRecord   ApplicationRecord  @relation(fields: [applicationRecordId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id])
  documents           ProgressDocument[]

  @@index([applicationRecordId])
  @@index([userId])
  @@map("progress_entries")
}

model ProgressDocument {
  id                  String            @id @default(cuid())
  progressEntryId     String
  applicationRecordId String
  requiredDocumentId  String
  createdAt           DateTime          @default(now())
  progressEntry       ProgressEntry     @relation(fields: [progressEntryId], references: [id], onDelete: Cascade)
  applicationRecord   ApplicationRecord @relation(fields: [applicationRecordId], references: [id], onDelete: Cascade)
  requiredDocument    RequiredDocument  @relation(fields: [requiredDocumentId], references: [id])

  @@unique([applicationRecordId, requiredDocumentId])
  @@index([requiredDocumentId])
  @@map("progress_documents")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([targetType, targetId])
  @@map("activity_log")
}

model PttApplicationRecord {
  id                                  String      @id @default(cuid())
  group                               String      @default("PTT")
  versionId                           String?
  pttNumber                           String?
  dateIssued                          DateTime?
  regionalOffice                      String?
  provincialOffice                    String?
  transporterName                     String?
  transporterAddress                  String?
  ptcNumber                           String?
  pcaRegistrationCertificateNumber    String?
  pcaRegistrationCertificateDate      DateTime?
  businessAddress                     String?
  boardFeetGranted                    Decimal?    @db.Decimal(12, 2)
  certificateOfQuantityVolumeAttached Boolean?
  volumeBoardFeet                     Decimal?    @db.Decimal(12, 2)
  originOfLumber                      String?
  destination                         String?
  consigneeName                       String?
  consigneePcaRegistration            String?
  transportType                       String?
  vehiclePlateNumber                  String?
  authorizedDriverName                String?
  authorizedDriverContact             String?
  amountPaid                          Decimal?    @db.Decimal(12, 2)
  actualFee                           Decimal?    @db.Decimal(12, 2)
  officialReceiptNumber               String?
  recordedValidityDays                Int?
  actualValidityDays                  Int?
  validityBasis                       PttValidityBasis?
  validUntil                          DateTime?
  dateValidatedInspected              DateTime?
  validatedInspectedBy                String?
  issuedByDate                        DateTime?
  issuedBy                            String?
  remarks                             String?
  createdById                         String
  editedById                          String?
  createdAt                           DateTime    @default(now())
  updatedAt                           DateTime    @updatedAt
  version                             PtcVersion? @relation(fields: [versionId], references: [id])
  createdBy                           User        @relation("CreatedPttRecords", fields: [createdById], references: [id])
  editedBy                            User?       @relation("EditedPttRecords", fields: [editedById], references: [id])
  checkRuns                           PttApplicationCheckRun[]
  checkFindings                       PttApplicationCheckFinding[]

  @@index([versionId])
  @@index([group])
  @@index([pttNumber])
  @@index([ptcNumber])
  @@index([editedById])
  @@map("ptt_application_records")
}

model PttTransportType {
  id               String                      @id @default(cuid())
  group            String                      @default("PTT")
  versionId        String
  name             String
  capacityCategory PttVehicleCapacityCategory?
  maxBoardFeet     Decimal?                    @db.Decimal(12, 2)
  active           Boolean                     @default(true)
  sortOrder        Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  version          PtcVersion                  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, name])
  @@index([group])
  @@index([versionId])
  @@map("ptt_transport_types")
}

model PttApplicationCheckRun {
  id                     String               @id @default(cuid())
  pttApplicationRecordId String
  checkType              PttCheckType
  appliedById            String
  inputSnapshot          Json
  ruleSnapshot           Json
  outputSnapshot         Json
  comparisonSnapshot     Json
  createdAt              DateTime             @default(now())
  pttApplicationRecord   PttApplicationRecord @relation(fields: [pttApplicationRecordId], references: [id], onDelete: Cascade)
  appliedBy              User                 @relation(fields: [appliedById], references: [id])

  @@index([pttApplicationRecordId, createdAt])
  @@index([appliedById])
  @@map("ptt_application_check_runs")
}

model PttApplicationCheckFinding {
  id                     String               @id @default(cuid())
  pttApplicationRecordId String
  checkType              PttCheckType
  message                String
  active                 Boolean              @default(true)
  comparisonSnapshot     Json
  resolvedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  pttApplicationRecord   PttApplicationRecord @relation(fields: [pttApplicationRecordId], references: [id], onDelete: Cascade)

  @@unique([pttApplicationRecordId, checkType])
  @@index([pttApplicationRecordId, active])
  @@map("ptt_application_check_findings")
}
